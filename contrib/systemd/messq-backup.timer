# SPDX-License-Identifier: Apache-2.0
#
# Off-peak schedule per docs/backup-restore.md: the read transaction pins the
# WAL while it runs, so the backup belongs in your quiet hours. Twice daily is
# the README-default; operators with bigger write volumes decide their own RPO.

[Unit]
Description=messq backup schedule (off-peak)

[Timer]
OnCalendar=*-*-* 02:15:00
OnCalendar=*-*-* 14:15:00
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
