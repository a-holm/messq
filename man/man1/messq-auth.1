.SH NAME
messq-auth - manage bearer tokens for daemon authentication


.SH SYNOPSIS
\fBmessq auth [flags]\fP


.SH DESCRIPTION
Create, list and verify the bearer credentials a messq daemon reads from
its --auth-file. Secrets are generated at cryptographic strength on this
machine, shown exactly once on stdout, and never accepted from argv or
environment variables: a credential that entered shell history is a
credential you must rotate.


.SH OPTIONS
\fB-h\fP, \fB--help\fP[=false]
	help for auth


.SH OPTIONS INHERITED FROM PARENT COMMANDS
\fB-a\fP, \fB--addr\fP="unix:///run/messq/messq.sock"
	daemon address (unix://, http://, https://)

.PP
\fB--color\fP="auto"
	colour: auto|always|never

.PP
\fB--full-ids\fP[=false]
	print full ULIDs instead of abbreviated ones

.PP
\fB-o\fP, \fB--output\fP="auto"
	output mode: auto|table|json|ndjson

.PP
\fB-q\fP, \fB--quiet\fP[=false]
	suppress narration; data and errors unaffected

.PP
\fB--timeout\fP=30s
	per-request deadline (0 = none)

.PP
\fB--token-file\fP=""
	file holding the bearer token, mode 0600

.PP
\fB-v\fP, \fB--verbose\fP[=0]
	narrate (-vv dumps each HTTP exchange and the resolved config)


.SH EXAMPLE
.EX
  messq auth add --auth-file /etc/messq/tokens --id ci --roles publish,consume --streams 'orders*' # noexec: writes to /etc/messq
  messq auth ls --auth-file /etc/messq/tokens # noexec: names a machine-specific token file
  printf '%s' "$CRED" | messq auth check --auth-file /etc/messq/tokens # noexec: shell pipeline carrying a credential
.EE


