# messq doctor — the prose diagnostic. --list and --explain are pure
# documentation surfaces, so their goldens are byte-stable.

messq doctor --list
cmp stdout want-list.txt

messq doctor --explain storage.wal_size
stdout 'storage.wal_size'

# An unknown check id is refused with the list.
exitcode 2 messq doctor --explain nosuchcheck
stderr 'nosuchcheck'

exitcode 2 messq doctor --fail-on loud
stderr 'invalid --fail-on'

-- want-list.txt --
{"checks":[{"id":"backup.none_configured","summary":"no backup directory is configured for monitoring"},{"id":"backup.perms","summary":"backup payloads readable beyond their owner"},{"id":"backup.stale","summary":"newest known snapshot is older than --backup-max-age"},{"id":"backup.unreadable","summary":"a snapshot on disk would not restore"},{"id":"consumer.filter_matches_nothing","summary":"consumer filters match none of the stream's recent subjects"},{"id":"consumer.flow_blocked","summary":"inflight pinned at max_ack_pending — workers are the bottleneck"},{"id":"consumer.idle","summary":"a consumer with backlog stopped being delivered anything"},{"id":"consumer.idle_no_backlog","summary":"nothing delivered for a long while, but there is no backlog either"},{"id":"consumer.max_deliver_unlimited","summary":"a consumer redelivers forever because max_deliver=0"},{"id":"consumer.max_deliver_unlimited_no_dlq","summary":"max_deliver=0 AND dead_policy=drop loses messages silently"},{"id":"consumer.oldest_pending","summary":"the oldest pending delivery is aging past useful"},{"id":"consumer.paused","summary":"this consumer has been paused for over an hour"},{"id":"consumer.stale_acks","summary":"acks are arriving after ack_wait (any nonzero rate alerts)"},{"id":"consumer.time_to_dead_exceeds_events","summary":"TimeToDead outruns event retention, so failures vanish before they can be diagnosed"},{"id":"dlq.growing_undrained","summary":"DLQ grew in the window while nobody redrove anything"},{"id":"dlq.no_consumer","summary":"dead letters piled up with nobody watching that DLQ"},{"id":"dlq.no_retention","summary":"a DLQ stream keeps everything forever"},{"id":"dlq.template_drift","summary":"an existing DLQ drifted from the current --dlq-* template"},{"id":"durability.fsync_implausible","summary":"an fdatasync faster than RAM suggests lying hardware"},{"id":"durability.fsync_probe","summary":"measures fdatasync latency and projects durable msg/s"},{"id":"durability.mode_relaxed","summary":"--durability=relaxed trades crash safety for latency"},{"id":"durability.pragma","summary":"what the synchronous pragma actually read back"},{"id":"durability.tmpfs","summary":"the data dir lives on tmpfs while durability demands otherwise"},{"id":"metrics.dropped_series","summary":"the metrics registry dropped series under pressure (#21)"},{"id":"security.cleartext_public","summary":"a non-loopback listener serves cleartext HTTP today"},{"id":"security.permissions","summary":"filesystem permissions around the data directory are wrong"},{"id":"security.tcp_no_auth","summary":"a TCP listener has no auth file protecting it"},{"id":"server.clock_jump","summary":"the wall clock regressed more than a second while running"},{"id":"server.janitor_disabled","summary":"--janitor-interval 0 disables retention and trims (#27)"},{"id":"server.restart_loop","summary":"three or more daemon starts inside the last hour"},{"id":"server.restored","summary":"this data directory was restored from a backup snapshot"},{"id":"server.sweep_interval","summary":"--sweep-interval outruns the smallest ack_wait (#11)"},{"id":"server.unclean_last_start","summary":"the most recent start followed an unclean shutdown"},{"id":"server.unreachable","summary":"the daemon this run pointed at did not answer"},{"id":"server.version_skew","summary":"CLI version differs from the daemon's version"},{"id":"storage.disk_headroom","summary":"free space versus minimum headroom and growth rate"},{"id":"storage.events_share","summary":"the events table eating more than its share of the database"},{"id":"storage.fs_type","summary":"names the filesystem under the data directory and refuses liars"},{"id":"storage.mount_options","summary":"nobarrier/barrier=0 void every durability claim on this mount"},{"id":"storage.readonly_latch","summary":"the daemon latched itself read-only after an fsyncgate event"},{"id":"storage.reserve_unavailable","summary":"fallocate is unsupported here — disk headroom shrank (#27)"},{"id":"storage.wal_size","summary":"WAL size above budget, or a reader pinning checkpoints too long"},{"id":"stream.no_consumers","summary":"a stream holds messages nobody consumes"},{"id":"stream.typo_suspect","summary":"a young, tiny, unconsumed stream looks like a typo of another stream"}]}
