#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# Full local gate. GitHub Actions runs the same `make ci`, so a red push is caught here first.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

if ! make ci; then
	echo >&2
	echo "pre-push: rejected. 'make ci' must be green before pushing." >&2
	exit 1
fi
